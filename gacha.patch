+  resourceId?: string;
+};
+
+export type PulledCard = { idea: GachaIdea; isNew: boolean; xp: number; gemRefund: number; pity: boolean };
+
+export type PullResult = {
+  batchId: string;
+  banner: string;
+  cards: PulledCard[];
+  gemsSpent: number;
+  gemsRefunded: number;
+  xpGained: number;
+  badgesUnlocked: string[];
+  wallet: GachaWallet;
+};
+
+export type CollectionItem = {
+  id: string;
+  kind: IdeaKind;
+  rarity: Rarity;
+  stars: number;
