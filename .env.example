# Copy to .env and fill in. docker compose reads it automatically.

# Turn on Claude-powered training plans, Pip chat and evidence summaries.
# Leave blank to use the built-in rule-based recommender.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Change these for any shared environment.
JWT_SECRET=please-change-this-to-a-long-random-string-0123456789
DB_PASSWORD=tpxgrow

# Only allow sign-ups from this email domain, e.g. tpximpact.com (blank = anyone)
ALLOWED_EMAIL_DOMAIN=

# Seed fictional colleagues, posts and reviews for demos
SEED_DEMO_DATA=true
